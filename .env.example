THREADS_ACCESS_TOKEN=ここにThreadsアクセストークンを貼る
THREADS_USER_ID=ここにThreadsユーザーIDを貼る
ANTHROPIC_API_KEY=ここにAnthropic APIキーを貼る

# 使用するClaudeモデル（任意）
# AI_MODEL=claude-sonnet-4-20250514

# ── Typefully 予約投稿連携（任意） ──────────────────────
# クラウド側で予約投稿するので、PCを開いていなくても自動投稿できる。
# Typefully（有料プラン）の Settings → API でキーを取得して貼る。
# 事前に Typefully に Threads アカウントを連携しておくこと。
# TYPEFULLY_API_KEY=ここにTypefullyのAPIキー
# 投稿先が複数あるとき固定したい場合のみ設定（通常は未設定でOK）
# TYPEFULLY_SOCIAL_SET_ID=

# ── 全自動投稿（autopost.py --loop）の調整 ──────────────
# 投稿する時間帯（カンマ区切り・HH:MM）。--loop はこの時刻に投稿する。
# デフォルトは「1日2本・6時間ごと」（14:00 と 20:00）。
# 本数を増やしたいときは時刻を増やす（例: 4回 → 07:30,12:15,18:00,21:00）
POST_SLOTS=14:00,20:00

# 1日の最大投稿本数（安全上限。スロットより少ない値にすると途中で止まる）
DAILY_LIMIT=2

# --count で連投するときの投稿間隔（秒）
# POST_INTERVAL_SEC=300
